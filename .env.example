# ==============================================================================
# AUTONOMOUS SRE INCIDENT RESPONSE AGENT - ENTERPRISE SELF-HOSTED CONFIGURATION
# ==============================================================================
# Hướng dẫn: Sao chép file này thành '.env' và điền các khóa bí mật của doanh nghiệp:
#   cp .env.example .env
# ==============================================================================

# 1. Cấu hình Trí tuệ Nhân tạo (Google Gemini)
# Lấy API Key tại: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.2

# 2. Cấu hình Tích hợp GitHub (Mở Pull Request & Issue tự động)
# Tạo Personal Access Token (classic) với quyền 'repo' tại: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_organization_or_username
GITHUB_DEFAULT_REPO=your_default_service_repository

# 3. Cấu hình Telegram Bot (Cảnh báo di động & Phê duyệt khẩn cấp từ xa)
# Tạo Bot tại Telegram @BotFather để nhận Bot Token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Chat ID của kênh hoặc kỹ sư trực ban (lấy qua @userinfobot):
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id
TELEGRAM_ENABLED=true
# (Tùy chọn) Khóa bí mật bảo vệ Webhook chống giả mạo:
TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_key

# 4. Cấu hình Hạ tầng & Cơ sở dữ liệu nội bộ
# Đường dẫn lưu trữ SQLite Checkpoint bền vững:
SQLITE_DB_PATH=data/incidents.db
